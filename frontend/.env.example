# URL of the backend /api prefix.
# Local dev (Vite dev-server proxy handles /api → localhost:5000):
VITE_API_URL=/api
#
# Production (Railway / Render / any hosted backend):
# VITE_API_URL=https://your-backend.railway.app/api
#
# IMPORTANT: the value MUST include the /api path segment.
# A bare origin such as https://your-backend.railway.app (without /api)
# will cause "Cannot POST /auth/login" errors because every request will
# be missing the /api prefix that the Express router expects.
